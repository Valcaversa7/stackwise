{# Sticky site header: brand · nav · search · mobile toggle #}
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" id="siteHeader">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} — home">
      <span class="brand-mark" aria-hidden="true">S</span>
      <span class="brand-name">Stack<span>wise</span></span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="siteNav"
      aria-label="Toggle navigation menu"
    ><span></span></button>

    <nav class="site-nav" id="siteNav" aria-label="Primary">
      {%- for item in site.nav %}
      <a
        href="{{ item.url }}"
        {% if item.url == page.url or (item.url != '/' and page.url and page.url.indexOf(item.url) === 0) %}aria-current="page"{% endif %}
      >{{ item.title }}</a>
      {%- endfor %}
    </nav>

    <div class="header-actions">
      {%- if site.search.enabled %}
      <form class="searchbar" role="search" action="{{ site.search.pageUrl }}" method="get">
        <label class="visually-hidden" for="site-search">Search {{ site.name }}</label>
        {% include "icons/search.svg" %}
        <input
          id="site-search"
          type="search"
          name="q"
          placeholder="Search…"
          autocomplete="off"
          spellcheck="false"
        >
        <button type="submit" aria-label="Submit search">
          {% include "icons/arrow-right.svg" %}
        </button>
      </form>
      {%- endif %}
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        role="switch"
        aria-checked="false"
        aria-label="Switch to dark mode"
        title="Toggle light / dark mode"
      >
        <span class="theme-toggle__thumb" aria-hidden="true">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="4.1"/><path d="M12 2.8v2.6M12 18.6v2.6M2.8 12h2.6M18.6 12h2.6M5.5 5.5l1.8 1.8M16.7 16.7l1.8 1.8M18.5 5.5l-1.8 1.8M7.3 16.7l-1.8 1.8"/></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M20.6 14.4A8.8 8.8 0 0 1 9.6 3.4a8.8 8.8 0 1 0 11 11z"/></svg>
        </span>
      </button>
    </div>
  </div>
</header>
