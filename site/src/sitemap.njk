---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
robots: "noindex"
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all %}
{%- if not entry.data.eleventyExcludeFromCollections and not (entry.data.robots and entry.data.robots.indexOf('noindex') !== -1) %}
  <url>
    <loc>{{ site.url }}{{ entry.url }}</loc>
    <lastmod>{{ (entry.data.updated or entry.date) | isoDate }}</lastmod>
    <changefreq>{% if entry.url == '/' %}daily{% elif entry.data.layout == 'layouts/post.njk' %}monthly{% else %}weekly{% endif %}</changefreq>
    <priority>{% if entry.url == '/' %}1.0{% elif entry.data.layout == 'layouts/post.njk' %}0.8{% else %}0.5{% endif %}</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
