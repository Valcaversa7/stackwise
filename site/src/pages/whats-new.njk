---
title: "What's New"
description: "The newest from Stackwise: breaking coverage of the events readers are asking about, followed by the latest guides, tutorials and reviews."
permalink: /whats-new/
---
{% extends "layouts/base.njk" %}

{% block main %}
<div class="shell">
  <div class="layout">
    <div class="layout__main">
      <header class="page-head">
        <p class="eyebrow">Updated as events develop</p>
        <h1>What's New</h1>
        <p>Breaking coverage first, then everything else we have published recently — guides, tutorials and reviews, newest first.</p>
      </header>

      {#- Featured coverage: the newest post tagged `news` -#}
      {%- set news = collections.newsPosts | limit(1) | first %}
      {%- if news %}
      <section class="section">
        <div class="section-head">
          <h2>Featured coverage</h2>
          <a href="{{ news.url }}">Full story</a>
        </div>
        {%- set post = news %}
        {%- set lead = true %}
        {%- set index = 0 %}
        {% include "partials/feature-card.njk" %}
      </section>
      {%- endif %}

      <section class="section">
        <div class="section-head">
          <h2>Latest articles</h2>
          <a href="/blog/">All {{ collections.posts.length }} posts</a>
        </div>
        <div class="post-grid">
          {%- for post in collections.posts | limit(6) %}
          {% include "partials/post-card.njk" %}
          {%- endfor %}
        </div>
      </section>

      <section class="section">
        <div class="widget widget--dark" style="padding:clamp(1.5rem,4vw,2.5rem)">
          {%- set variant = "inline" -%}
          {%- set suffix = "-whatsnew" -%}
          {% include "partials/newsletter.njk" %}
        </div>
      </section>
    </div>

    <div class="layout__side">
      {% include "partials/sidebar.njk" %}
    </div>
  </div>
</div>
{% endblock %}
